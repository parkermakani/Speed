###########################################
# Speed Does America – Environment Example #
###########################################

# ---- General Environment ----
ENV=development  # set to "production" for deployment

# ---- Supabase (Primary Database, Auth, Storage) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=speed-media

# Client ID for multi-tenant isolation
SPEED_CLIENT_ID=speed-does-america

# ---- Frontend Supabase (Vite) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Backend Secrets ----
MAPBOX_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Curator.io (optional; prefer JSON URL or API base+key+feed id)
CURATOR_JSON_URL=
CURATOR_API_BASE=https://api.curator.io
CURATOR_API_KEY=
CURATOR_FEED_ID=

# ---- Frontend (Vite) ----
VITE_MAPBOX_TOKEN=$MAPBOX_TOKEN
VITE_API_BASE_URL=http://localhost:8000

# Set to 'true' locally to shuffle cities order in UI
VITE_SHUFFLE_CITIES=false

# ---- Shopify (optional) ----
# Enable to source products from Shopify while keeping our own UI
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_COLLECTION_HANDLE=
VITE_SHOPIFY_COLLECTION_ID=
VITE_SHOPIFY_COLLECTION_GID=

# ---- Legacy Firebase (Keep for migration script, remove after migration) ----
# FIREBASE_SERVICE_ACCOUNT_JSON=/absolute/path/to/serviceAccount.json
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
