###########################################
# Speed Does America – Environment Example #
###########################################

# ---- General Environment ----
ENV=development  # set to "production" on Replit

# ---- Backend Secrets ----
MAPBOX_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
# Curator.io (optional; prefer JSON URL or API base+key+feed id)
CURATOR_JSON_URL=
CURATOR_API_BASE=https://api.curator.io
CURATOR_API_KEY=
CURATOR_FEED_ID=

# ---- Firebase (Shared) ----
# Client SDK config
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Set to 'true' locally to shuffle cities order in UI so real tour order isn't leaked in dev
VITE_SHUFFLE_CITIES=false

# Backend service account credentials (absolute path)
FIREBASE_SERVICE_ACCOUNT_JSON=/absolute/path/to/serviceAccount.json

# ---- Frontend (Vite) ----
VITE_MAPBOX_TOKEN=$MAPBOX_TOKEN
VITE_API_BASE_URL=http://localhost:8000

# ---- Shopify (optional) ----
# Enable to source products from Shopify while keeping our own UI
# Example domain: ishowspeed-shop.myshopify.com
VITE_SHOPIFY_DOMAIN=
# Storefront access token (public token scoped to Storefront API)
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Choose ONE of the following identifiers
# 1) Preferred: collection handle (e.g., "summer-collection")
VITE_SHOPIFY_COLLECTION_HANDLE=
# 2) Or collection numeric ID (e.g., 438116909287)
VITE_SHOPIFY_COLLECTION_ID=
# 3) Or full GID (e.g., gid://shopify/Collection/438116909287)
VITE_SHOPIFY_COLLECTION_GID=
